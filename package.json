{
  "name": "code-blog-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "vite",
    "build": "npm run security:lockfile && tsc -b && vite build",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write .",
    "preview": "vite preview",
    "security:lockfile": "node check-lockfile.mjs",
    "security:audit": "npm audit --audit-level=high && npm audit signatures",
    "security:check": "npm run security:lockfile && npm run security:audit"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@tailwindcss/vite": "4.1.18",
    "@tanstack/react-query": "5.90.20",
    "@tanstack/react-router": "1.170.39",
    "axios": "1.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.1.18",
    "zod": "4.4.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "axios": "1.20.0",
    "form-data": "4.0.6",
    "follow-redirects": "1.16.0",
    "js-yaml": "4.3.2",
    "postcss": "8.5.28",
    "seroval": "1.6.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@tanstack/router-plugin": "1.168.40",
    "@types/node": "24.10.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "msw": "2.12.7",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "vite": "7.3.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
