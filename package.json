{
  "name": "code-blog-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "vite",
    "build": "npm run security:lockfile && tsc -b && vite build",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "typecheck": "tsc -b",
    "check": "biome check && npm run typecheck",
    "format": "biome format --write",
    "preview": "vite preview",
    "security:lockfile": "node check-lockfile.mjs",
    "security:audit": "npm audit --audit-level=high && npm audit signatures",
    "security:check": "npm run security:lockfile && npm run security:audit"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@tailwindcss/vite": "4.1.18",
    "@tanstack/react-query": "5.90.20",
    "@tanstack/react-router": "1.170.39",
    "axios": "1.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.1.18",
    "zod": "4.4.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "axios": "1.20.0",
    "form-data": "4.0.6",
    "follow-redirects": "1.16.0",
    "postcss": "8.5.28",
    "seroval": "1.6.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tanstack/router-plugin": "1.168.40",
    "@types/node": "24.10.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "msw": "2.12.7",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
